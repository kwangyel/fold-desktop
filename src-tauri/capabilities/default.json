{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:menu:default",
    "pty-commands",
    "git-commands",
    "project-commands",
    "github-commands",
    "claude-commands",
    "cursor-commands",
    "auth-commands",
    "dialog:default",
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://fold.optulus.com/*" },
        { "url": "https://avatars.githubusercontent.com/*" },
        { "url": "https://github.com/*" }
      ]
    }
  ]
}
